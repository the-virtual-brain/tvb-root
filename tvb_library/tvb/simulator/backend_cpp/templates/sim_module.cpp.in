  static constexpr std::size_t kDelayedSelfFeedbackSourceSvar = {{DELAYED_SELF_FEEDBACK_SOURCE_SVAR}};
  static constexpr std::size_t kDelayedSelfFeedbackTargetSvar = {{DELAYED_SELF_FEEDBACK_TARGET_SVAR}};
