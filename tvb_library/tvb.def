Bootstrap: docker
From: debian:bookworm-slim

%labels
    Name tvb-hybrid-numba
    Version 2.11.0
    Description TVB library + numba + jupyterlab for running demos via nbconvert

%environment
    export MPLBACKEND=Agg
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH
    export TVB_ROOT=/opt/tvb-root
    # tvb_storage location writable inside container
    export TVB_STORAGE=/tmp/tvb_storage

%files
    tvb_library /opt/tvb-root/tvb_library
    tvb_bin /opt/tvb-root/tvb_bin

%post
    # --- system deps ---
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential \
        python3 python3-dev python3-venv python3-pip \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

    # --- install uv ---
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # --- create venv with uv (system python) ---
    uv venv /opt/venv
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH

    # --- install python deps with uv ---
    # tvb-library deps (from its pyproject) + docs/demo extras
    uv pip install \
        "numba" "numexpr" "numpy" "scipy" "matplotlib" "networkx" "mako>=1.1.4" \
        "Deprecated" "docutils" "ipywidgets" "autopep8" "six" \
        "jupyterlab" "nbconvert" "nbclient" "ipykernel" "ipympl" \
        "h5py" "tvb-data" "tvb-gdist" \
        "seaborn" "tqdm" "pandas" \
        "pyAesCrypt"

    # --- install tvb-library (editable) and tvb-bin from local source ---
    cd /opt/tvb-root/tvb_library && uv pip install --no-deps -e .
    cd /opt/tvb-root/tvb_bin && uv pip install --no-deps -e . || echo "tvb-bin install skipped (optional)"

    # make a default tvb_storage dir
    mkdir -p /tmp/tvb_storage

%runscript
    exec "$@"